{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "insulin_calc",
  "version": "0.1.0",
  "identifier": "com.insulin.calc-app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Инсулин Калькулятор",
        "url": "https://localhost:3000/web-application-development_frontend/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
